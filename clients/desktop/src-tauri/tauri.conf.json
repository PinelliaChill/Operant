{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Operant",
  "version": "0.1.0",
  "identifier": "dev.operant.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix ../gui run dev",
    "beforeBuildCommand": "npm --prefix ../gui run build",
    "devUrl": "http://127.0.0.1:3000",
    "frontendDist": "../../gui/dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8000; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    },
    "windows": [
      {
        "title": "Operant",
        "width": 1280,
        "height": 820,
        "minWidth": 390,
        "minHeight": 640,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["app"]
  }
}
